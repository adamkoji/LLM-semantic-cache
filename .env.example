# Gemini API Key (optional for local offline testing — falls back to deterministic local safety net if omitted)
GOOGLE_API_KEY=your_gemini_api_key_here

# Primary Gemini model (3-node failover cascade: gemini-3.6-flash -> gemini-3.5-flash-lite -> gemini-3.8-flash)
GEMINI_MODEL=gemini-3.6-flash

# Per-node HTTP timeout (seconds) before shifting to the next model in the cascade
LLM_TIMEOUT_SECONDS=15.0

# Dense Embedding Model (384-dim L2-normalized vectors)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Tier-1 Exact Cache (automatically falls back to thread-safe in-memory OrderedDict LRU if Redis is unreachable)
REDIS_URL=redis://localhost:6379

# Tier-2 ChromaDB Persistent Vector Directory
CHROMA_PERSIST_DIR=./.chroma_cache
